* {
  box-sizing: border-box;
}

:root {
  color-scheme: dark;
  --bg: #070b17;
  --bg-soft: #0d1323;
  --panel: rgba(16, 20, 35, 0.88);
  --panel-alt: rgba(12, 16, 31, 0.96);
  --line: rgba(146, 170, 255, 0.16);
  --text: #edf2ff;
  --muted: #9da9c3;
  --green: #4ae6a3;
  --green-strong: #19d68a;
  --red: #ff5d73;
  --red-strong: #ff4d67;
  --violet: #9b6cff;
  --violet-strong: #7b57f4;
  --shadow: 0 20px 45px rgba(8, 12, 22, 0.4);
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-height: 100vh;
  font-family: Inter, 'Segoe UI', sans-serif;
  background:
    radial-gradient(circle at top, rgba(123, 87, 244, 0.22), transparent 35%),
    radial-gradient(circle at bottom right, rgba(74, 230, 163, 0.18), transparent 25%),
    var(--bg);
  color: var(--text);
}

body {
  min-height: 100vh;
}

button, input, select, textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px 16px 48px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
}

.eyebrow,
.small-label {
  margin: 0 0 6px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 11px;
  color: var(--muted);
}

h1, h2, h3, p {
  margin-top: 0;
}

h1 {
  margin-bottom: 0;
  font-size: clamp(1.8rem, 5vw, 2.8rem);
  letter-spacing: 0.04em;
}

.card {
  background: linear-gradient(180deg, rgba(16, 20, 35, 0.95), rgba(9, 13, 23, 0.96));
  border: 1px solid var(--line);
  border-radius: 20px;
  box-shadow: var(--shadow);
}

.hero-panel {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 26px 22px;
  margin-bottom: 18px;
}

.hero-panel h2 {
  font-size: clamp(1.4rem, 2vw, 2rem);
  margin-bottom: 0;
}

.hero-message {
  max-width: 420px;
  background: rgba(123, 87, 244, 0.12);
  border: 1px solid rgba(155, 108, 255, 0.3);
  border-radius: 12px;
  padding: 12px 14px;
  color: var(--muted);
  line-height: 1.5;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: 1.1fr 1.1fr;
  gap: 18px;
}

.stats-row {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(4, minmax(120px, 1fr));
  gap: 16px;
}

.stat-card {
  padding: 18px 20px;
  min-height: 112px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10px;
}

.stat-card span {
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--muted);
}

.stat-card strong {
  font-size: clamp(1.5rem, 4vw, 2.2rem);
}

.accent-green { border-color: rgba(74, 230, 163, 0.45); }
.accent-red { border-color: rgba(255, 93, 115, 0.45); }
.accent-violet { border-color: rgba(155, 108, 255, 0.45); }

.entry-card,
.analysis-grid > .card,
.card:not(.github-card):not(.integration-card) {
  padding: 18px 18px 20px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.section-header h3 {
  margin-bottom: 0;
  font-size: 1.08rem;
}

.result-form,
.period-form {
  display: grid;
  gap: 12px;
}

label {
  display: grid;
  gap: 8px;
  color: var(--muted);
  font-size: 0.82rem;
  letter-spacing: 0.04em;
}

input, select, textarea {
  appearance: none;
  width: 100%;
  background: rgba(6, 9, 18, 0.9);
  border: 1px solid rgba(162, 178, 229, 0.18);
  border-radius: 12px;
  padding: 12px 14px;
  color: var(--text);
}

input:focus, select:focus, textarea:focus {
  outline: 2px solid rgba(74, 230, 163, 0.28);
  border-color: rgba(74, 230, 163, 0.7);
}

.button-row {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 4px;
}

.primary-button,
.secondary-button,
.danger-button {
  border: none;
  border-radius: 12px;
  padding: 10px 16px;
  font-weight: 700;
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.primary-button:hover,
.secondary-button:hover,
.danger-button:hover,
.primary-button:focus-visible,
.secondary-button:focus-visible,
.danger-button:focus-visible {
  transform: translateY(-1px);
}

.primary-button {
  background: linear-gradient(135deg, var(--green), var(--green-strong));
  color: #04140d;
}

.secondary-button {
  background: rgba(155, 108, 255, 0.18);
  color: var(--text);
  border: 1px solid rgba(155, 108, 255, 0.35);
}

.danger-button {
  background: rgba(255, 93, 115, 0.14);
  color: #ffdfe6;
  border: 1px solid rgba(255, 93, 115, 0.4);
}

.analysis-grid {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.bar-group {
  display: grid;
  gap: 12px;
}

.bar-row {
  display: grid;
  grid-template-columns: 60px 1fr 42px;
  gap: 10px;
  align-items: center;
}

.bar-track {
  width: 100%;
  height: 12px;
  border-radius: 999px;
  background: rgba(143, 160, 214, 0.12);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: inherit;
}

.bar-fill.green { background: linear-gradient(90deg, var(--green), #89f8c6); }
.bar-fill.red { background: linear-gradient(90deg, var(--red), #ff9aac); }
.bar-fill.violet { background: linear-gradient(90deg, var(--violet), #c7a5ff); }

.trend-list {
  display: grid;
  gap: 10px;
}

.trend-item {
  display: grid;
  grid-template-columns: 60px 52px 80px 1fr;
  gap: 12px;
  align-items: center;
  padding: 10px 12px;
  border-radius: 12px;
  border: 1px solid var(--line);
  background: rgba(8, 13, 22, 0.82);
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 72px;
  padding: 5px 8px;
  border-radius: 999px;
  font-size: 0.72rem;
  letter-spacing: 0.04em;
  text-transform: capitalize;
}

.chip.red { background: rgba(255, 93, 115, 0.14); color: #ffd2da; }
.chip.green { background: rgba(74, 230, 163, 0.14); color: #d4fee8; }
.chip.violet { background: rgba(155, 108, 255, 0.14); color: #e2d7ff; }

.table-wrap {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 520px;
}

th, td {
  padding: 12px 10px;
  border-bottom: 1px solid var(--line);
  text-align: left;
}

th {
  color: var(--muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.7rem;
}

.empty-state {
  color: var(--muted);
  text-align: center;
  padding: 12px 0;
}

.period-list {
  display: grid;
  gap: 10px;
  margin-top: 18px;
}

.period-row {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: rgba(9, 13, 24, 0.82);
}

.period-row p {
  margin-bottom: 0;
  color: var(--muted);
}

.period-meta {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
  gap: 8px;
}

.integration-card,
.github-card {
  padding: 18px;
}

.integration-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
  margin-top: 16px;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  padding: 8px 12px;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.status-pill.enabled {
  background: rgba(74, 230, 163, 0.12);
  border: 1px solid rgba(74, 230, 163, 0.4);
  color: #c7ffea;
}

.status-pill.paused {
  background: rgba(255, 93, 115, 0.1);
  border: 1px solid rgba(255, 93, 115, 0.35);
  color: #ffd2da;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 20px;
  padding: 12px 16px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(9, 13, 24, 0.82);
  color: var(--muted);
}

@media (max-width: 900px) {
  .dashboard-grid {
    grid-template-columns: 1fr;
  }

  .analysis-grid {
    grid-template-columns: 1fr;
  }

  .stats-row {
    grid-template-columns: repeat(2, minmax(130px, 1fr));
  }
}

@media (max-width: 640px) {
  .app-shell {
    padding: 14px 12px 24px;
  }

  .topbar,
  .hero-panel,
  .integration-row,
  .status-bar {
    flex-direction: column;
    align-items: stretch;
  }

  .stats-row {
    grid-template-columns: 1fr;
  }

  .button-row {
    flex-direction: column;
  }

  .primary-button,
  .secondary-button,
  .danger-button {
    width: 100%;
  }

  .trend-item {
    grid-template-columns: 1fr 1fr 1fr auto;
  }
}

@media (prefers-reduced-motion: reduce) {
  * {
    scroll-behavior: auto !important;
    transition: none !important;
  }
}
