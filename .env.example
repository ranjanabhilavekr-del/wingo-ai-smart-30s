import express from 'express';
import cors from 'cors';
import path from 'path';
import fs from 'fs';
import Database from 'better-sqlite3';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
const PORT = Number(process.env.PORT || 3001);
const dataDir = path.join(__dirname, 'data');
const dbPath = path.join(dataDir, 'wingo.db');
const apiKey = process.env.API_KEY || 'local-dev-key';
const isProd = process.env.NODE_ENV === 'production';

fs.mkdirSync(dataDir, { recursive: true });

const db = new Database(dbPath);
db.pragma('journal_mode = WAL');

db.exec(`
  CREATE TABLE IF NOT EXISTS results (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    period_number INTEGER NOT NULL UNIQUE,
    number INTEGER NOT NULL CHECK (number BETWEEN 0 AND 9),
    color TEXT NOT NULL CHECK (color IN ('red', 'green', 'violet')),
    big_small TEXT NOT NULL CHECK (big_small IN ('big', 'small')),
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
  );

  CREATE TABLE IF NOT EXISTS periods (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    period_number INTEGER NOT NULL UNIQUE,
    label TEXT,
    notes TEXT,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
  );

  CREATE TABLE IF NOT EXISTS settings (
    key TEXT PRIMARY KEY,
    value TEXT NOT NULL
  );
`);

const setSetting = (key, value) => {
  db.prepare('INSERT INTO settings(key, value) VALUES(?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value').run(key, String(value));
};

const getSetting = (key, fallback = '') => {
  const row = db.prepare('SELECT value FROM settings WHERE key = ?').get(key);
  return row ? row.value : fallback;
};

setSetting('integration_status', 'not_configured');
setSetting('integration_endpoint', 'https://your-authorized-game-api.example');
setSetting('integration_enabled', 'false');

const ensureAuth = (req, res, next) => {
  if (req.method === 'GET' && req.path.startsWith('/health')) {
    return next();
  }

  if (req.path.startsWith('/api')) {
    const providedKey = req.headers['x-api-key'] || req.query.api_key;
    if (!providedKey || providedKey !== apiKey) {
      return res.status(401).json({ error: 'API key required.' });
    }
  }

  next();
};

const normalizeResult = (result) => {
  const number = Number(result.number);
  const bigSmall = number >= 5 ? 'big' : 'small';
  return {
    ...result,
    number,
    big_small: bigSmall,
  };
};

const analyzeResults = (results) => {
  const colors = { red: 0, green: 0, violet: 0 };
  const bigSmall = { big: 0, small: 0 };

  results.forEach((result) => {
    colors[result.color] = (colors[result.color] || 0) + 1;
    bigSmall[result.big_small] = (bigSmall[result.big_small] || 0) + 1;
  });

  const trend = results
    .slice()
    .sort((a, b) => Number(a.period_number) - Number(b.period_number))
    .map((result) => ({
      period_number: Number(result.period_number),
      number: Number(result.number),
      color: result.color,
      big_small: result.big_small,
    }));

  const totalResults = results.length;
  const averageNumber = totalResults > 0 ? results.reduce((sum, item) => sum + Number(item.number), 0) / totalResults : 0;
  const lastResult = totalResults > 0 ? results[results.length - 1] : null;

  return {
    summary: {
      totalResults,
      averageNumber,
      lastResult: lastResult ? { period_number: lastResult.period_number, number: lastResult.number, color: lastResult.color, big_small: lastResult.big_small } : null,
      bigCount: bigSmall.big,
      smallCount: bigSmall.small,
      redCount: colors.red,
      greenCount: colors.green,
      violetCount: colors.violet,
    },
    colors,
    bigSmall,
    trend,
  };
};

app.use(cors());
app.use(express.json({ limit: '1mb' }));
app.use(ensureAuth);

app.get('/api/health', (req, res) => {
  res.json({ status: 'ok', service: 'wingo-ai-smart-30s', timestamp: new Date().toISOString() });
});

app.get('/api/results', (req, res) => {
  const rows = db.prepare('SELECT * FROM results ORDER BY period_number ASC').all();
  res.json(rows);
});

app.post('/api/results', (req, res) => {
  const body = req.body || {};
  const periodNumber = Number(body.period_number);
  const number = Number(body.number);
  const color = String(body.color || 'red');

  if (!Number.isInteger(periodNumber) || periodNumber < 1) {
    return res.status(400).json({ error: 'Valid period number is required.' });
  }

  if (!Number.isInteger(number) || number < 0 || number > 9) {
    return res.status(400).json({ error: 'Result number must be an integer between 0 and 9.' });
  }

  if (!['red', 'green', 'violet'].includes(color)) {
    return res.status(400).json({ error: 'Color must be red, green, or violet.' });
  }

  const normalized = normalizeResult({ period_number: periodNumber, number, color });

  try {
    const inserted = db.prepare(`
      INSERT INTO results (period_number, number, color, big_small)
      VALUES (@period_number, @number, @color, @big_small)
      ON CONFLICT(period_number) DO UPDATE SET
        number = excluded.number,
        color = excluded.color,
        big_small = excluded.big_small,
        created_at = CURRENT_TIMESTAMP
    `).run(normalized);

    const stored = db.prepare('SELECT * FROM results WHERE period_number = ?').get(periodNumber);
    return res.status(201).json({ inserted: inserted.changes, result: stored });
  } catch (error) {
    return res.status(500).json({ error: 'Unable to save result.', detail: error.message });
  }
});

app.delete('/api/results', (req, res) => {
  db.prepare('DELETE FROM results').run();
  return res.json({ success: true, count: 0 });
});

app.delete('/api/results/:period_number', (req, res) => {
  const periodNumber = Number(req.params.period_number);
  const statement = db.prepare('DELETE FROM results WHERE period_number = ?');
  const result = statement.run(periodNumber);

  if (result.changes === 0) {
    return res.status(404).json({ error: 'Result not found.' });
  }

  return res.json({ success: true, period_number: periodNumber });
});

app.get('/api/periods', (req, res) => {
  const rows = db.prepare('SELECT * FROM periods ORDER BY period_number ASC').all();
  res.json(rows);
});

app.post('/api/periods', (req, res) => {
  const body = req.body || {};
  const periodNumber = Number(body.period_number);
  const label = String(body.label || `Period ${periodNumber}`);
  const notes = String(body.notes || '');

  if (!Number.isInteger(periodNumber) || periodNumber < 1) {
    return res.status(400).json({ error: 'Period number must be a positive integer.' });
  }

  try {
    const row = db.prepare(`
      INSERT INTO periods (period_number, label, notes)
      VALUES (?, ?, ?)
      ON CONFLICT(period_number) DO UPDATE SET
        label = excluded.label,
        notes = excluded.notes,
        created_at = CURRENT_TIMESTAMP
    `).run(periodNumber, label, notes);

    const stored = db.prepare('SELECT * FROM periods WHERE period_number = ?').get(periodNumber);
    return res.status(201).json({ inserted: row.changes, period: stored });
  } catch (error) {
    return res.status(500).json({ error: 'Unable to save period.', detail: error.message });
  }
});

app.delete('/api/periods/:period_number', (req, res) => {
  const periodNumber = Number(req.params.period_number);
  const result = db.prepare('DELETE FROM periods WHERE period_number = ?').run(periodNumber);
  if (result.changes === 0) {
    return res.status(404).json({ error: 'Period not found.' });
  }
  return res.json({ success: true, period_number: periodNumber });
});

app.get('/api/dashboard', (req, res) => {
  const results = db.prepare('SELECT * FROM results ORDER BY period_number ASC').all();
  const periods = db.prepare('SELECT * FROM periods ORDER BY period_number ASC').all();
  const stats = analyzeResults(results);

  return res.json({
    results,
    periods,
    ...stats,
  });
});

app.get('/api/integration-status', (req, res) => {
  const enabled = getSetting('integration_enabled', 'false') === 'true';
  const endpoint = getSetting('integration_endpoint', 'https://your-authorized-game-api.example');
  const status = getSetting('integration_status', 'not_configured');

  res.json({
    enabled,
    endpoint,
    status,
    message: 'Integration is ready for secure, authorized external API hooks when credentials are supplied.',
  });
});

app.put('/api/integration-status', (req, res) => {
  const body = req.body || {};
  const enabled = Boolean(body.enabled);
  const endpoint = String(body.endpoint || getSetting('integration_endpoint', 'https://your-authorized-game-api.example'));
  const status = enabled ? 'enabled' : 'paused';

  setSetting('integration_enabled', String(enabled));
  setSetting('integration_endpoint', endpoint);
  setSetting('integration_status', status);

  return res.json({
    enabled,
    endpoint,
    status,
    message: enabled
      ? 'Secure integration mode enabled. Add credentials to authorize live game data access.'
      : 'Integration paused. Analysis-only mode remains active.',
  });
});

if (isProd) {
  const buildDir = path.join(__dirname, 'dist');
  app.use(express.static(buildDir));
  app.get('*', (req, res) => {
    if (req.path.startsWith('/api/')) {
      return res.status(404).json({ error: 'API endpoint not found.' });
    }
    res.sendFile(path.join(buildDir, 'index.html'));
  });
}

app.listen(PORT, () => {
  console.log(`WINGO AI SMART 30S API running on http://localhost:${PORT}`);
});

export default app;
